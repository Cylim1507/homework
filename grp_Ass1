-- Creating the database for RFID tracking
CREATE DATABASE rfid_tracker;

-- Use the created database
USE rfid_tracker;

-- Creating the table to store RFID scan data (FSR reading removed)
CREATE TABLE rfid_scans (
    scan_id INT AUTO_INCREMENT PRIMARY KEY, -- Unique ID for each scan
    rfid_uid VARCHAR(11) NOT NULL,         -- RFID UID (e.g., "F3 BF AA A0", max 11 chars for 4 bytes in HEX with spaces)
    zone CHAR(1) NOT NULL,                 -- Zone (A, B, or C)
    scan_time DATETIME NOT NULL,           -- Timestamp of the scan
    status VARCHAR(20) DEFAULT 'Processed', -- Status of the scan (e.g., Processed, Error)
    location_name VARCHAR(50),             -- Descriptive name for the zone (optional)
    CONSTRAINT chk_zone CHECK (zone IN ('A', 'B', 'C')) -- Ensure zone is A, B, or C
);

